# Vercel > Project > Settings > Environment Variables bölümüne girilir.
# Gerçek değerleri ASLA bu dosyaya ya da koda yazmayın: repo herkese açık.

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# Sadece sunucuda kullanılır; tarayıcıya asla gitmez.
SUPABASE_SERVICE_ROLE_KEY=

# iyzico (merchant.iyzipay.com > Ayarlar > API)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Test: https://sandbox-api.iyzipay.com  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Resend (sipariş bildirimi)
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=

# Sitenin tam adresi (iyzico dönüş adresi için)
SITE_URL=https://merisclean.com

# Vercel cron isteklerini doğrulamak için (Vercel otomatik gönderir)
CRON_SECRET=
